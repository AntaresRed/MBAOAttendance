# Settings for the nightly IIMPresent sync (sync/send-attendance.mjs).
# Copy to sync/.env, fill in, and keep it out of the repository (.gitignore already excludes .env).

# Our own Supabase project: the job reads attendance with the service role key, so keep this file
# readable only by the account that runs the job.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The receiver. Both values come from the IIMPresent maintainer, handed over out of band.
IIMPRESENT_ENDPOINT=https://<their-project-ref>.supabase.co/functions/v1/ingest-office-attendance
IIMPRESENT_KEY_ID=k1
IIMPRESENT_SECRET=

# Which term these records belong to.
TERM=V

# Leave as is to send dry_run batches the receiver validates and throws away.
# Set to false (or pass --live) only once the dry runs come back clean.
DRY_RUN=true

# Optional
# PAGE_SIZE=500        # rows per request; the contract's limit is 500
# AS_OF=2026-09-19     # override the last processed class date
